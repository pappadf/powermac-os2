\ SPDX-License-Identifier: GPL-2.0-only
\ os2shim -- boot OS/2 Warp (PowerPC Edition) on an Apple Network Server 500/700
\ or a Power Macintosh 7500/8500/9500
\
\ With the OS/2 PowerPC CD 1 at SCSI ID 3 on the 53C825A (the Network Server's
\ first fast/wide bus, or a 53C825A card in a Power Macintosh's slot A1), or
\ OS/2 installed on a hard disk:
\     load fd:,\os2boot.of
\     load-base loadsize eval
\ The firmware stays in its factory, big-endian mode and this floppy sets no
\ NVRAM variable.  SHIM.XCF's first stage asks the firmware for the RAM size,
\ then switches the CPU and the PCI bridges to little-endian itself, until the
\ next reset (shim/stage0.c).
\
\ This reads SHIM.XCF off this floppy at 16 MB, moves it to load-base, lays it
\ out with the ROM's xcoff-loader (which claims 0x600000 itself) and starts it.  @SECTORS@ is
\ filled in by mkfloppy.sh.

0 value os2-xl
0 value os2-fd

\ Claim and map pages virtual == physical through /chosen's memory and mmu
\ instances, as a client program would.  The claim is bookkeeping and may fail
\ where the firmware holds the page already; the map goes through regardless.
" /chosen" find-package drop value os2-chosen
: os2-ih ( name$ -- ihandle ) os2-chosen get-package-property drop decode-int nip nip ;
" memory" os2-ih value os2-mem
" mmu" os2-ih value os2-mmu
: os2-claim ( addr size -- ) 0 " claim" os2-mem ['] $call-method catch if 2drop 2drop 2drop else drop then ;
: os2-map ( addr size -- ) 2dup os2-claim over swap 0 " map" os2-mmu $call-method ;
\ Map only: the pages xcoff-loader lays the image out in.  It claims them
\ itself (a claim made here first makes its own fail), but a Power Macintosh's
\ loader does not map what it claims and would fault writing them.
: os2-map-only ( addr size -- ) over swap 0 " map" os2-mmu $call-method ;

\ A firmware already running little-endian was set up by an earlier version
\ of this floppy (`little-endian? true`).  This one needs the factory setting.
: os2-little?  ( -- flag )  1 pad !  pad c@ 1 = ;

: os2-undo
   ." os2shim: this firmware is running little-endian: an earlier os2shim floppy" cr
   ." os2shim: set little-endian? true.  This floppy needs no NVRAM setting;" cr
   ." os2shim: restore the factory value, then load this script again:" cr
   ."     setenv little-endian? false" cr
   ."     reset-all" cr
;

: os2-boot
   " /packages/xcoff-loader" open-dev to os2-xl
   1000000 @MAPLEN@ os2-map
   " /bandit/gc/swim3" open-dev to os2-fd
@READS@
   os2-fd close-dev
   load-base @MAPLEN@ os2-map
   600000 @IMGLEN@ os2-map-only
   1000000 load-base @SIZE@ move
   @SIZE@ to loadsize
   " init-program" os2-xl $call-method
   ." os2shim: starting" cr
   go
;

: os2-main  os2-little? if os2-undo else os2-boot then ;
os2-main
